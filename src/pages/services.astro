---
import BaseLayout from "../layouts/BaseLayout.astro";
import { services } from "../data/services";
import { techniques } from "../data/site";
---

<BaseLayout title="Services" description="Dataset engineering, LLM fine-tuning, diffusion training, evaluation, and deployment handoff.">
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <p class="section-label">Services</p>
    <h1 class="heading-display mt-2 text-3xl md:text-4xl">End-to-end model training</h1>
    <p class="lead mt-4">
      We specialize in <span class="text-instrument">open-weight</span> stacks—not proprietary black-box APIs. Every engagement includes clear deliverables and <span class="text-instrument">eval gates</span> before handoff.
    </p>
    <p class="p-instrument mt-4">
      Dataset engineering, training, and deployment documentation in one statement of work.
    </p>
  </section>

  <section class="mx-auto max-w-6xl space-y-16 px-4 pb-20">
    {
      services.map((s, i) => (
        <article class:list={["grid gap-8 md:grid-cols-2 md:items-center", i % 2 === 1 && "md:[direction:rtl]"]}>
          <div class:list={["glass-card p-8", i % 2 === 1 && "md:[direction:ltr]"]}>
            <h2 class="text-2xl font-semibold">{s.title}</h2>
            <p class="mt-3 text-muted">{s.summary}</p>
            <ul class="mt-6 space-y-2 text-sm text-muted">
              {s.bullets.map((b) => (
                <li class="flex gap-2">
                  <span class="text-accent" aria-hidden="true">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class:list={["h-32 rounded-xl border border-border bg-bg-elevated md:h-48", i % 2 === 1 && "md:[direction:ltr]"]} aria-hidden="true" />
        </article>
      ))
    }
  </section>

  <section class="border-t border-border bg-bg-elevated/30 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-xl font-semibold">Training techniques</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {techniques.map((t) => (
          <span class="chip-instrument">{t}</span>
        ))}
      </div>
      <a href="/get-started" class="btn-primary mt-10 inline-flex">Start project</a>
    </div>
  </section>
</BaseLayout>
