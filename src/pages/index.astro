---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSplit from "../components/HeroSplit.astro";
import PartnerMarquee from "../components/PartnerMarquee.astro";
import ModelTabs from "../components/ModelTabs.astro";
import { pillars, processSteps } from "../data/site";
import { getHomeUseCases } from "../data/useCases";
---

<BaseLayout>
  <HeroSplit />

  <PartnerMarquee />

  <section class="mx-auto max-w-7xl px-4 py-20 lg:px-8" data-stagger data-ruler-section="Workflow">
    <p class="section-kicker text-center">How we work</p>
    <h2 class="heading-section mt-2 text-center text-2xl md:text-3xl">Dataset → Train → Ship</h2>
    <p class="copy-bridge mx-auto mt-3 max-w-lg text-center">
      From raw data to evaluated weights, in three stages.
    </p>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        pillars.map((p) => (
          <div data-stagger-item class="panel-hover p-6">
            <h3 class="text-base font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>
            <p class="copy-caption mt-3">{p.instrumentLine}</p>
          </div>
        ))
      }
    </div>
  </section>

  <ModelTabs />

  <section class="border-y border-border py-20" data-ruler-section="Use cases">
    <div class="mx-auto max-w-7xl px-4 lg:px-8" data-stagger>
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="section-kicker">Applications</p>
          <h2 class="heading-section mt-2 text-2xl md:text-3xl">Use cases we build for</h2>
        </div>
        <a href="/use-cases" class="text-link text-sm font-medium">All use cases →</a>
      </div>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          getHomeUseCases(6).map((u) => (
            <a href={`/get-started?use_case=${u.id}`} data-stagger-item class="panel-hover block p-5">
              <span class="copy-caption text-faint">{u.industry}</span>
              <h3 class="mt-2 font-medium">{u.title}</h3>
              <p class="mt-1.5 text-sm text-muted">{u.heroLine}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 lg:px-8" data-stagger data-ruler-section="Process">
    <p class="section-kicker">Process</p>
    <h2 class="heading-section mt-2 text-2xl md:text-3xl">From discovery to handoff</h2>
    <p class="copy-bridge mt-3 max-w-xl">
      Typical durations. Actual timelines depend on data readiness and project scope.
    </p>
    <ol class="mt-10 grid gap-3 md:grid-cols-5">
      {
        processSteps.map((s, i) => (
          <li data-stagger-item class="panel p-5">
            <span class="step-index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-2 font-medium">{s.title}</h3>
            <p class="copy-caption text-faint">{s.duration}</p>
            <p class="p-instrument mt-2 text-[12px] leading-relaxed">{s.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 lg:px-8" data-ruler-section="Get started">
    <div class="panel flex flex-col items-start justify-between gap-6 p-8 md:flex-row md:items-center md:p-12">
      <div class="max-w-xl">
        <h2 class="heading-display text-2xl md:text-[2.25rem]">Ready to train on your data?</h2>
        <p class="p-instrument mt-3 text-[12px]">
          Share your goals, data, and timeline. We will scope a milestone plan before any training begins.
        </p>
      </div>
      <a href="/get-started" class="btn-primary shrink-0">Start Project</a>
    </div>
  </section>
</BaseLayout>
