---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-lg px-4 py-32 text-center">
    <p class="text-6xl font-bold text-accent/50">404</p>
    <h1 class="mt-4 text-2xl font-bold">Page not found</h1>
    <p class="mt-2 text-muted">The page you requested is not on this site.</p>
    <a href="/" class="btn-primary mt-8 inline-flex">Home</a>
  </section>
</BaseLayout>
