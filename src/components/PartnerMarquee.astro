---
import { partners } from "../data/site";
---

<section class="border-y border-border bg-surface/50 py-6" aria-label="Technology partners">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-4 lg:px-8">
    {
      partners.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13px] font-medium text-faint transition-colors duration-150 hover:text-muted"
        >
          {p.name}
        </a>
      ))
    }
  </div>
</section>
