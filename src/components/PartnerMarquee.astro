---
import BrandLogo from "./BrandLogo.astro";
import { partners } from "../data/site";
---

<section class="border-y border-border bg-surface/50 py-8" aria-label="Technology partners" data-ruler-section="Partners">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-12 gap-y-6 px-4 lg:px-8">
    {
      partners.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-2.5 rounded-lg px-2 py-1 text-muted transition-colors duration-150 hover:text-primary"
        >
          <BrandLogo brand={p.brand} size={26} class="text-faint transition-colors group-hover:text-primary" labeled />
          <span class="sr-only">{p.name}</span>
          <span class="hidden text-[13px] font-medium sm:inline" aria-hidden="true">
            {p.name}
          </span>
        </a>
      ))
    }
  </div>
</section>
