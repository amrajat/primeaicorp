---
import HeroPipeline from "./HeroPipeline.astro";
import { site } from "../data/site";

const examples = [
  { label: "LLM assistant", href: "/get-started?use_case=enterprise-rag" },
  { label: "Product LoRA", href: "/get-started?use_case=ecom-photo" },
  { label: "Code copilot", href: "/get-started?use_case=code-assistant" },
];
---

<section class="bg-surface/60">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-14 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-8 lg:py-20">
    <div class="max-w-xl">
      <p class="flex flex-wrap items-center gap-2 text-sm">
        <span class="rounded-md bg-primary px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-primary-foreground">New</span>
        <a href="/models" class="text-link text-sm font-medium text-text">Open-model catalog for 2025 →</a>
      </p>
      <h1 class="heading-display mt-6 text-[2.85rem] sm:text-[3.25rem] lg:text-[3.85rem]">
        Model training that ships you the <span class="font-elsh-heart text-primary">weights</span>.
      </h1>
      <p class="lead mt-5">
        Fine-tune Llama, Qwen, FLUX, and Stable Diffusion on your data—with evals, license review, and deployment in AWS, Modal, or your VPC.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/get-started" class="btn-primary">
          Start project
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/contact" class="text-link text-sm">Talk to us →</a>
      </div>
      <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-border pt-10">
        <div>
          <dt class="stat-value">$5K+</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">Typical pilot engagements</dd>
        </div>
        <div>
          <dt class="stat-value">40+</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">Open model families we train</dd>
        </div>
        <div>
          <dt class="stat-value">Your cloud</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">VPC &amp; on-prem options</dd>
        </div>
      </dl>
    </div>

    <div class="relative min-h-[420px] lg:min-h-[480px]" data-hero-tab-panel>
      <div class="absolute inset-0">
        <HeroPipeline />
      </div>
      <div class="panel absolute left-4 right-4 top-8 mx-auto max-w-md p-5 sm:left-auto sm:right-6 sm:top-10 lg:max-w-[380px]">
        <div class="flex gap-1 rounded-full bg-surface p-1 text-center" role="tablist" aria-label="Project type">
          <button type="button" class="hero-tab tab-pill tab-pill-active flex-1" data-hero-tab="llm">LLM training</button>
          <button type="button" class="hero-tab tab-pill flex-1" data-hero-tab="diffusion">Diffusion</button>
          <button type="button" class="hero-tab tab-pill flex-1" data-hero-tab="multimodal">Multimodal</button>
        </div>
        <label for="hero-brief" class="sr-only">Project brief</label>
        <textarea
          id="hero-brief"
          rows="5"
          class="input-field mt-4 resize-none text-base"
          placeholder="Describe your dataset, use case, and target model…"
          readonly
        ></textarea>
        <p class="mt-3 text-xs text-muted">
          <span class="rounded-full bg-primary-muted px-2 py-0.5 font-medium text-primary font-elsh-triangle text-[11px] tracking-wide">Projects from $5,000</span>
        </p>
        <p class="mt-4 text-xs font-medium text-muted">Try an example</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            examples.map((ex) => (
              <a href={ex.href} class="rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-medium text-text hover:border-primary/40 hover:bg-primary-subtle">
                {ex.label}
              </a>
            ))
          }
        </div>
        <div class="mt-5 flex gap-2">
          <a href="/get-started" class="btn-secondary flex-1 justify-center py-2.5 text-xs">Full intake</a>
          <a href="/get-started" class="btn-outline-primary flex-1 justify-center py-2.5 text-xs">Send brief</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".hero-tab");
  const field = document.getElementById("hero-brief") as HTMLTextAreaElement | null;
  const copy: Record<string, string> = {
    llm: "Example: 200k internal support tickets to fine-tune Llama 3.1 8B for tone-aligned replies. Need DPO pass + VPC deploy.",
    diffusion: "Example: 3k product photos for SDXL / FLUX LoRA—consistent studio lighting for our SKU catalog.",
    multimodal: "Example: Warehouse QC photos + defect labels to fine-tune Qwen2-VL for structured JSON into our MES.",
  };

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const key = tab.dataset.heroTab ?? "llm";
      tabs.forEach((t) => {
        t.classList.toggle("tab-pill-active", t === tab);
      });
      if (field) field.placeholder = copy[key] ?? copy.llm;
    });
  });
</script>
