---
import { site, navLinks, legalLinks } from "../data/site";
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 lg:grid-cols-4 lg:px-8">
    <div>
      <p class="text-sm font-medium">{site.name}</p>
      <p class="mt-2 text-sm text-muted">{site.tagline}</p>
      <p class="mt-4 text-sm">
        <a href={`mailto:${site.emails.sales}`} class="text-link">{site.emails.sales}</a>
      </p>
    </div>
    <div>
      <p class="type-eyebrow">Company</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about" class="text-muted hover:text-text">About</a></li>
        <li><a href="/contact" class="text-muted hover:text-text">Contact</a></li>
        <li><a href="/get-started" class="text-link">Start project</a></li>
      </ul>
    </div>
    <div>
      <p class="type-eyebrow">Expertise</p>
      <ul class="mt-3 space-y-2 text-sm">
        {navLinks.slice(0, 3).map((l) => (
          <li>
            <a href={l.href} class="text-muted hover:text-text">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="type-eyebrow">Legal</p>
      <ul class="mt-3 space-y-2 text-sm">
        {legalLinks.map((l) => (
          <li>
            <a href={l.href} class="text-muted hover:text-text">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-border py-5">
    <p class="mx-auto max-w-7xl px-4 text-xs leading-relaxed text-faint lg:px-8">
      © {new Date().getFullYear()} {site.name}. DPA requests, privacy rights, and subprocessors - {" "}
      <a href={`mailto:${site.emails.legal}`} class="text-faint hover:text-muted">{site.emails.legal}</a>
    </p>
  </div>
</footer>
