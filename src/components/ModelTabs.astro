---
import BrandLogo from "./BrandLogo.astro";
import { modelBrandKey } from "../lib/brands";
import { models, modelFamilyLabels, type ModelFamily } from "../data/models";

const families: ModelFamily[] = ["llm", "diffusion", "multimodal"];

function byFamily(f: ModelFamily) {
  return models.filter((m) => m.family === f).slice(0, 8);
}
---

<section class="mx-auto max-w-7xl px-4 py-20 lg:px-8" id="featured-models" data-stagger data-ruler-section="Models">
  <p class="section-kicker">Model families</p>
  <h2 class="heading-section mt-2 text-2xl md:text-3xl">Open stacks we train</h2>
  <p class="copy-bridge mt-2 max-w-xl">License review on every engagement—not legal advice in the cards below.</p>

  <div class="mt-6 flex flex-wrap gap-1.5" role="tablist">
    {
      families.map((f, i) => (
        <button
          type="button"
          role="tab"
          data-tab={f}
          class:list={[
            "model-tab rounded-md px-3 py-1.5 text-[13px] font-medium transition-colors duration-150",
            i === 0 ? "tab-pill-active" : "text-muted hover:text-text",
          ]}
        >
          {modelFamilyLabels[f]}
        </button>
      ))
    }
  </div>

  {
    families.map((f, i) => (
      <div data-panel={f} class:list={["mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4", i > 0 && "hidden"]}>
        {byFamily(f).map((m) => (
          <div data-stagger-item class="panel-hover p-4">
            <div class="flex items-start gap-3">
              {modelBrandKey[m.id] ? (
                <BrandLogo brand={modelBrandKey[m.id]} size={22} class="mt-0.5 text-primary/80" labeled />
              ) : null}
              <p class="min-w-0 flex-1 text-[13px] font-semibold leading-snug">{m.name}</p>
            </div>
            <p class="mt-2 text-xs leading-relaxed text-muted">{m.trainerNote}</p>
            <p class="copy-caption mt-2 text-faint">{m.licenseHint}</p>
          </div>
        ))}
      </div>
    ))
  }

  <a href="/models" class="btn-secondary mt-8 inline-flex">View full catalog</a>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".model-tab");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const f = tab.dataset.tab;
      panels.forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== f));
      tabs.forEach((t) => {
        const on = t.dataset.tab === f;
        t.classList.toggle("tab-pill-active", on);
        t.classList.toggle("text-muted", !on);
      });
    });
  });
</script>
