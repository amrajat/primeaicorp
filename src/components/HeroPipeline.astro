---
/** Inline SVG — beige-only pipeline, Geist Serif labels */
---

<svg
  id="hero-pipeline"
  class="h-full w-full rounded-2xl"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 800 520"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="hg" x1="0" y1="0" x2="800" y2="520" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#0f1011"></stop>
      <stop offset="1" stop-color="#141516"></stop>
    </linearGradient>
    <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M 32 0 L 0 0 0 32" fill="none" stroke="rgb(255 255 255 / 0.04)" stroke-width="1"></path>
    </pattern>
  </defs>
  <rect width="800" height="520" rx="24" fill="url(#hg)"></rect>
  <rect width="800" height="520" rx="24" fill="url(#grid)"></rect>
  <rect x="80" y="360" width="120" height="72" rx="8" stroke="rgb(255 255 255 / 0.1)" fill="rgb(255 255 255 / 0.02)"></rect>
  <text x="140" y="395" text-anchor="middle" fill="#9a9da6" font-family="Geist Serif, Georgia, serif" font-size="11">Dataset</text>
  <rect x="280" y="320" width="120" height="72" rx="8" stroke="rgb(229 224 214 / 0.45)" fill="rgb(229 224 214 / 0.06)"></rect>
  <text x="340" y="355" text-anchor="middle" fill="#e5e0d6" font-family="Geist Serif, Georgia, serif" font-size="11">Train</text>
  <rect x="480" y="280" width="120" height="72" rx="8" stroke="rgb(255 255 255 / 0.1)" fill="rgb(255 255 255 / 0.02)"></rect>
  <text x="540" y="315" text-anchor="middle" fill="#9a9da6" font-family="Geist Serif, Georgia, serif" font-size="11">Eval</text>
  <rect x="620" y="240" width="120" height="72" rx="8" stroke="rgb(229 224 214 / 0.35)" fill="rgb(229 224 214 / 0.05)"></rect>
  <text x="680" y="275" text-anchor="middle" fill="#e5e0d6" font-family="Geist Serif, Georgia, serif" font-size="11">Ship</text>
  <path d="M200 396 H280" stroke="rgb(229 224 214 / 0.55)" stroke-width="2" stroke-dasharray="4 6"></path>
  <path d="M400 356 H480" stroke="rgb(255 255 255 / 0.15)" stroke-width="2" stroke-dasharray="4 6"></path>
  <path d="M600 316 H620" stroke="rgb(255 255 255 / 0.15)" stroke-width="2" stroke-dasharray="4 6"></path>
  <circle id="train-pulse" cx="200" cy="396" r="4" fill="#e5e0d6"></circle>
  <g id="train-orbit" transform="translate(400 180)">
    <circle r="64" stroke="rgb(255 255 255 / 0.06)"></circle>
    <circle r="32" stroke="rgb(229 224 214 / 0.3)"></circle>
    <text y="4" text-anchor="middle" fill="#9a9da6" font-family="Geist Serif, Georgia, serif" font-size="10">.safetensors</text>
  </g>
</svg>
